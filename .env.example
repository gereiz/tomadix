# ==============================================================================
# CINEPROMPT STUDIO AI - VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO
# ==============================================================================

# Ambiente de execução ('production' | 'development' | 'test')
NODE_ENV="production"
APP_URL="https://app.cineprompt.ai"

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connection Pooling (Porta 6543 - PgBouncer com Transaction Mode para Next.js / Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&connect_timeout=20"

# Conexão Direta (Porta 5432 - Necessária para migrações do Prisma com 'prisma migrate deploy')
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ------------------------------------------------------------------------------
# 2. MOTOR DE IA (Google Gemini API)
# ------------------------------------------------------------------------------
# Chave de API corporativa da Google Cloud Console / Google AI Studio
GEMINI_API_KEY="AIzaSy..."

# Modelo padrão de inferência de prompts cinematográficos
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 3. GATEWAYS DE PAGAMENTO & COBRANÇA RECORRENTE
# ------------------------------------------------------------------------------
# Provedor ativo ('stripe' ou 'mercadopago')
PAYMENT_GATEWAY_PROVIDER="stripe"

# Stripe (Produção)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLIC_KEY="pk_live_..."

# Mercado Pago (Alternativa)
MERCADO_PAGO_ACCESS_TOKEN="APP_USR-..."
MERCADO_PAGO_WEBHOOK_SECRET="..."

# ------------------------------------------------------------------------------
# 4. SEGURANÇA E OPERAÇÕES DA PLATAFORMA
# ------------------------------------------------------------------------------
# E-mails com acesso emergencial de administrador da plataforma (separados por vírgula)
ADMIN_EMAILS="diretoria@cineprompt.ai,georgie.reis@outlook.com"

# Nível de logging estruturado ('info' | 'warn' | 'error' | 'debug')
LOG_LEVEL="info"
