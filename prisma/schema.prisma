generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ParameterType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  BOOLEAN
  NUMBER
  RANGE
  DURATION
  JSON
  DATE
}

enum ParameterScope {
  GLOBAL
  CHARACTER
  ENVIRONMENT
  SCENE
  OUTPUT
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELING
  CANCELED
  UNPAID
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum CreditOrigin {
  ADHESION
  MONTHLY_RENEWAL
  DAILY_RENEWAL
  PROMOTIONAL
  PURCHASED
  ADMIN_OVERRIDE
  REFUND
  LEGACY
}

enum CreditLotStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum SpaceVisibility {
  PRIVATE
  TEAM
  SELECTED
}

model User {
  id                          String             @id @default(cuid())
  authSubject                 String             @unique
  email                       String             @unique
  displayName                 String?
  passwordHash                String?
  platformRole                PlatformRole       @default(USER)
  isSuspended                 Boolean            @default(false)
  suspendedAt                 DateTime?
  suspensionReason            String?
  emailConfirmed              Boolean            @default(false)
  emailConfirmationToken      String?            @unique
  emailConfirmationExpiresAt  DateTime?
  passwordResetToken          String?            @unique
  passwordResetExpiresAt      DateTime?
  preferences                 Json?              @default("{}")
  onboardingCompleted         Boolean            @default(false)
  onboardingStep              Int                @default(1)
  memberships                 Membership[]
  sessions                    Session[]
  auditLogs                   AuditLog[]
  sentInvites                 WorkspaceInvite[]    @relation("SentInvites")
  platformAuditLogs           PlatformAuditLog[]   @relation("AdminAuditLogs")
  consents                    ConsentRecord[]
  dataSubjectRequests         DataSubjectRequest[]
  entitlementOverrides        UserEntitlementOverride[]
  creditLots                  CreditLot[]
  geminiApiKeys               GeminiApiKey[]       @relation("CreatedGeminiKeys")
  generatedImages             GeneratedImage[]
  generatedVideos             GeneratedVideo[]
  spaceMemberships            SpaceMember[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([platformRole])
  @@index([isSuspended])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String   // "TERMS_OF_SERVICE", "PRIVACY_POLICY", "MARKETING_EMAILS", "AI_DATA_PROCESSING"
  version     String   // "1.0", "2026-10"
  granted     Boolean  @default(true)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([consentType, createdAt])
}

model DataSubjectRequest {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  requestType String    // "ACCESS", "RECTIFICATION", "DELETION", "REVOCATION", "PORTABILITY"
  status      String    @default("PENDING") // "PENDING", "IN_REVIEW", "COMPLETED", "REJECTED"
  details     String?
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([requestType, status])
}

model PlatformAuditLog {
  id          String       @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  result      String       @default("SUCCESS")
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  adminUser   User         @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  isPersonal     Boolean           @default(false)
  isArchived     Boolean           @default(false)
  archivedAt     DateTime?
  settings       Json?             @default("{}")
  creditsBalance Int               @default(20)
  memberships    Membership[]
  invites        WorkspaceInvite[]
  projects                    Project[]
  subscription                Subscription?
  invoices                    Invoice[]
  creditLedgers               CreditLedger[]
  creditLots                  CreditLot[]
  entitlementOverrides        UserEntitlementOverride[]
  generatedImages             GeneratedImage[]
  generatedVideos             GeneratedVideo[]
  transfersFrom               ProjectOwnershipTransfer[] @relation("TransfersFrom")
  transfersTo                 ProjectOwnershipTransfer[] @relation("TransfersTo")
  createdAt                   DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([isArchived])
}

model Plan {
  id                    String         @id @default(cuid())
  tier                  PlanTier       @unique
  code                  String?        @unique
  name                  String
  description           String
  badge                 String?
  displayOrder          Int            @default(0)
  isHighlighted         Boolean        @default(false)
  targetAudience        String?
  commercialStatus      String         @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  isPublic              Boolean        @default(true)
  priceMonthly          Int            @default(0)
  priceYearly           Int            @default(0)
  currency              String         @default("BRL")
  annualDiscountPercent Int            @default(0)
  trialDays             Int            @default(0)
  promoPriceMonthly     Int?
  promoPriceYearly      Int?
  promoStartsAt         DateTime?
  promoEndsAt           DateTime?
  isOfferAvailable      Boolean        @default(true)
  externalGatewayIds    Json?          @default("{}")
  maxProjects           Int            @default(2)
  unlimitedProjects     Boolean        @default(false)
  maxMembers            Int            @default(1)
  unlimitedMembers      Boolean        @default(false)
  maxCharacters         Int?
  unlimitedCharacters   Boolean        @default(true)
  maxEnvironments       Int?
  unlimitedEnvironments Boolean        @default(true)
  maxScenes             Int?
  unlimitedScenes       Boolean        @default(true)
  monthlyCredits        Int            @default(20)
  adhesionCredits       Int            @default(0)
  dailyCredits          Int            @default(0)
  dailyCreditsAccumulative Boolean     @default(false)
  isFreePlan            Boolean        @default(false)
  maxConcurrentJobs     Int            @default(1)
  rateLimitPerMin       Int            @default(30)
  maxInputChars         Int            @default(10000)
  generationTypes       Json           @default("[\"TEXT\", \"DETAILED\", \"CINEMATIC\"]")
  hasPremiumTemplates   Boolean        @default(false)
  hasAdvancedParameters Boolean        @default(false)
  historyRetentionDays  Int            @default(30)
  unlimitedHistory      Boolean        @default(false)
  exportFormats         Json           @default("[\"TXT\", \"JSON\"]")
  priorityProcessing    Boolean        @default(false)
  features              Json           @default("[]")
  enabledTemplates      Json           @default("[]")
  exportAllowed         Boolean        @default(true)
  visualBibleAdvanced   Boolean        @default(false)
  hasImageGeneration        Boolean        @default(false)
  imageDailyLimit           Int?
  imageMonthlyLimit         Int?
  imageTotalLimit           Int?
  imageDefaultCost          Int            @default(10)
  imageAllowedModels        Json           @default("[]")
  imageMaxBatchSize         Int            @default(1)
  imageAllowedResolutions   Json           @default("[\"1024x1024\", \"1280x720\", \"720x1280\"]")
  imageAllowReferenceImages Boolean        @default(false)
  imageRetentionDays        Int            @default(15) // Dias que as imagens geradas ficam armazenadas no servidor
  unlimitedImageRetention   Boolean        @default(false) // Armazenamento vitalício sem expiração de imagens
  hasVideoGeneration        Boolean        @default(false)
  videoDailyLimit           Int?
  videoMonthlyLimit         Int?
  videoTotalLimit           Int?
  videoDefaultCost          Int            @default(25)
  videoAllowedModels        Json           @default("[]")
  videoRetentionDays        Int            @default(15)
  unlimitedVideoRetention   Boolean        @default(false)
  customRules           Json?          @default("{}")
  gatewayProductId      String?
  gatewayPriceIdMonthly String?
  gatewayPriceIdYearly  String?
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
  gatewayMappings       GatewayPlanPriceMapping[]
}

model Subscription {
  id                    String             @id @default(cuid())
  workspaceId           String             @unique
  planTier              PlanTier           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  interval              BillingInterval    @default(MONTHLY)
  billingUserId         String?
  customerId            String?
  gatewaySubscriptionId String?            @unique
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                  Plan               @relation(fields: [planTier], references: [tier])
  invoices              Invoice[]

  @@index([workspaceId, status])
  @@index([customerId])
  @@index([gatewaySubscriptionId])
}

model Invoice {
  id               String        @id @default(cuid())
  subscriptionId   String?
  workspaceId      String
  gatewayInvoiceId String?       @unique
  amountDue        Int
  amountPaid       Int
  currency         String        @default("BRL")
  status           String        @default("paid")
  hostedInvoiceUrl String?
  pdfUrl           String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model CreditLedger {
  id             String        @id @default(cuid())
  workspaceId    String
  amount         Int
  balanceAfter   Int
  reason         String
  lotId          String?
  origin         CreditOrigin?
  operationCode  String?
  idempotencyKey String?
  userId         String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lot            CreditLot?    @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([lotId])
  @@index([idempotencyKey])
}

model CreditLot {
  id              String          @id @default(cuid())
  workspaceId     String
  userId          String?
  origin          CreditOrigin
  amountGranted   Int
  amountAvailable Int
  amountConsumed  Int             @default(0)
  status          CreditLotStatus @default(ACTIVE)
  isAccumulative  Boolean         @default(true)
  validFrom       DateTime        @default(now())
  expiresAt       DateTime?
  planTier        PlanTier?
  subscriptionId  String?
  eventId         String?
  reason          String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  creditLedgers   CreditLedger[]

  @@index([workspaceId, status, expiresAt])
  @@index([workspaceId, origin])
  @@index([eventId])
}

model CreditConsumptionConfig {
  id                  String   @id @default(cuid())
  version             Int      @default(1)
  categoryPriorities  Json     // Array ordenado: ["DAILY_NON_ACCUMULATIVE", "PROMOTIONAL", "DAILY_ACCUMULATIVE", "MONTHLY_RENEWAL", "ADHESION", "PURCHASED", "ADMIN_OVERRIDE", "REFUND", "LEGACY"]
  protectedCategories Json     @default("[]") // Categorias protegidas contra consumo automático
  description         String?
  updatedByUserId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([version])
}

model ProcessedWebhookEvent {
  id          String   @id
  gateway     String
  eventType   String
  processedAt DateTime @default(now())
  payload     Json?
  status      String   @default("PROCESSED")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  status      InviteStatus  @default(PENDING)
  invitedById String
  invitedBy   User          @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([token])
}

model Project {
  id              String          @id @default(cuid())
  workspaceId     String
  ownerUserId     String?
  title           String
  description     String          @default("")
  genre           String?
  language        String          @default("pt-BR")
  durationSeconds Int?
  configuration   Json            @default("{}")
  visualBible     Json?
  visibility      SpaceVisibility @default(TEAM)
  thumbnailUrl    String?
  isArchived      Boolean         @default(false)
  archivedAt      DateTime?
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parameterValues ParameterValue[]
  characters      Character[]
  environments    Environment[]
  scenes          Scene[]
  generations     GenerationJob[]
  transfers       ProjectOwnershipTransfer[]
  generatedImages GeneratedImage[]
  generatedVideos GeneratedVideo[]
  spaceMembers    SpaceMember[]
  boards          SpaceBoard[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, isArchived])
  @@index([workspaceId, visibility])
  @@index([ownerUserId])
}

model SpaceMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  canEdit   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model SpaceBoard {
  id        String      @id @default(cuid())
  projectId String
  name      String      @default("Page 1")
  order     Int         @default(0)
  viewport  Json        @default("{\"x\":0,\"y\":0,\"zoom\":1}")
  nodes     BoardNode[]
  edges     BoardEdge[]
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([projectId, order])
}

model BoardNode {
  id        String     @id @default(cuid())
  boardId   String
  type      String     // "IMAGE" | "PROMPT" | "TEXT_NOTE" | "CHARACTER" | "ENVIRONMENT" | "SCENE" | "VIDEO"
  x         Float      @default(0)
  y         Float      @default(0)
  width     Float?
  height    Float?
  zIndex    Int        @default(0)
  refType   String?    // "GENERATED_IMAGE" | "PROMPT_VERSION" | "CHARACTER" | "ENVIRONMENT" | "SCENE"
  refId     String?
  data      Json       @default("{}")
  board     SpaceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([boardId])
  @@index([refType, refId])
}

model BoardEdge {
  id           String     @id @default(cuid())
  boardId      String
  sourceNodeId String
  targetNodeId String
  sourceHandle String?
  targetHandle String?
  label        String?
  animated     Boolean    @default(false)
  data         Json       @default("{}")
  board        SpaceBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([boardId])
}

model ParameterDefinition {
  id             String          @id @default(cuid())
  workspaceId    String?
  key            String
  label          String
  description    String?
  type           ParameterType
  scope          ParameterScope @default(GLOBAL)
  scopes         Json?
  required       Boolean         @default(false)
  defaultValue   Json?
  options        Json?
  validationRules Json?
  visibilityRules Json?
  promptMapping  Json?
  order          Int             @default(0)
  version        Int             @default(1)
  isSystem       Boolean         @default(false)
  enabled        Boolean         @default(true)
  values          ParameterValue[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, key, version])
  @@index([workspaceId, enabled, scope])
}

model ParameterValue {
  id                   String              @id @default(cuid())
  projectId             String
  parameterDefinitionId String
  targetType            String              @default("PROJECT")
  targetId              String?
  value                 Json
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition            ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([projectId, targetType, targetId])
  @@index([parameterDefinitionId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  attributes  Json     @default("{}")
  isArchived  Boolean  @default(false)
  archivedAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneLinks  SceneCharacter[]
  generatedImages GeneratedImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, name])
  @@index([projectId, isArchived])
  @@index([projectId, isArchived, updatedAt(sort: Desc)])
}

model Environment {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  attributes  Json     @default("{}")
  isArchived  Boolean  @default(false)
  archivedAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneLinks  SceneEnvironment[]
  generatedImages GeneratedImage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, name])
  @@index([projectId, isArchived])
  @@index([projectId, isArchived, updatedAt(sort: Desc)])
}

model Scene {
  id              String             @id @default(cuid())
  projectId       String
  title           String
  order           Int
  durationSeconds Int?
  description     String             @default("")
  configuration   Json               @default("{}")
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characters      SceneCharacter[]
  environments    SceneEnvironment[]
  promptVersions  PromptVersion[]
  generatedImages GeneratedImage[]
  generatedVideos GeneratedVideo[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([projectId, order])
  @@index([projectId, order])
  @@index([projectId, updatedAt(sort: Desc)])
}

model SceneCharacter {
  sceneId       String
  characterId   String
  configuration Json      @default("{}")
  scene         Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([sceneId, characterId])
  @@index([characterId])
}

model SceneEnvironment {
  sceneId       String
  environmentId String
  configuration Json        @default("{}")
  scene         Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([sceneId, environmentId])
  @@index([environmentId])
}

model PromptTemplate {
  id             String   @id @default(cuid())
  key            String
  name           String
  version        Int
  outputSchema   String
  instructions   String
  sections       Json
  enabled        Boolean  @default(true)
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([key, version])
  @@index([key, enabled])
}

model PromptVersion {
  id                  String   @id @default(cuid())
  sceneId             String?
  projectId           String
  templateKey         String
  templateVersion     Int
  targetTool           String
  modelName            String
  inputSnapshot        Json
  outputJson           Json
  outputText           String?
  createdAt            DateTime @default(now())
  scene                Scene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  generatedImages      GeneratedImage[]

  @@index([projectId, createdAt(sort: Desc)])
  @@index([sceneId, createdAt])
}

model GenerationJob {
  id             String           @id @default(cuid())
  projectId      String
  status         GenerationStatus @default(PENDING)
  modelName      String
  request        Json
  result         Json?
  errorMessage   String?
  inputTokens    Int?
  outputTokens   Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([projectId, status, createdAt])
}

model CommercialPolicy {
  id           String   @id @default(cuid())
  key          String   @unique
  category     String   // "CREDITS" | "SUBSCRIPTIONS" | "USAGE_LIMITS" | "COMMERCIALIZATION" | "GENERAL"
  label        String
  description  String?
  dataType     String   @default("string") // "string" | "number" | "boolean" | "json"
  value        Json
  defaultValue Json
  validation   Json?
  isSystem     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@index([category])
}

model CommercialSnapshot {
  id             String   @id @default(cuid())
  subscriptionId String?
  workspaceId    String
  planTier       PlanTier
  snapshotData   Json
  acceptedAt     DateTime @default(now())
  acceptedBy     String?
  version        String   @default("v1")
  reason         String   @default("NEW_CONTRACT")

  @@index([workspaceId, planTier])
  @@index([subscriptionId])
}

model PaymentGatewayConfig {
  id                   String   @id @default(cuid())
  name                 String
  identifier           String   @unique
  provider             String   // "STRIPE" | "MERCADOPAGO" | "SANDBOX"
  environment          String   @default("SANDBOX") // "SANDBOX" | "PRODUCTION"
  status               String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "CONFIG_PENDING" | "ERROR"
  connectionStatus     String   @default("UNTESTED") // "CONNECTED" | "DISCONNECTED" | "UNTESTED" | "FAILED"
  encryptedCredentials Json?
  supportedCurrencies  Json     @default("[\"BRL\", \"USD\"]")
  supportedCountries   Json     @default("[\"BR\"]")
  paymentMethods       Json     @default("[\"CREDIT_CARD\"]")
  lastTestedAt         DateTime?
  lastError            String?
  isCheckoutDefault    Boolean  @default(false)
  priorityOrder        Int      @default(0)
  selectionRules       Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  mappings             GatewayPlanPriceMapping[]
  webhookEvents        PaymentWebhookEvent[]

  @@index([provider, environment])
  @@index([status, environment])
}

model GatewayPlanPriceMapping {
