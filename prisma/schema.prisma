// ----------------------------------------------------
// GERENCIAMENTO MULTI-KEY & FAILOVER GEMINI API
// ----------------------------------------------------

enum GeminiKeyStatus {
  HEALTHY
  DEGRADED
  RATE_LIMITED
  SUSPENDED
  INVALID
}

enum GeminiSelectionStrategy {
  SEQUENTIAL_PRIORITY
  BALANCED
  LEAST_USED
}

model GeminiApiKey {
  id                  String                   @id @default(cuid())
  name                String                   // Identificador descritivo (ex: "Chave Principal GCP Prod", "Chave Backup 1")
  apiKey              String                   // Chave completa persistida com segurança
  maskedKey           String                   // Versão mascarada para exibição pública segura (ex: AIzaSy...X9kP)
  isActive            Boolean                  @default(true)
  priority            Int                      @default(1) // 1 = maior prioridade
  status              GeminiKeyStatus          @default(HEALTHY)
  
  // Métricas operacionais e contadores
  requestsCount       Int                      @default(0)
  successCount        Int                      @default(0)
  failuresCount       Int                      @default(0)
  consecutiveFailures Int                      @default(0)
  
  // Timestamps de atividade
  lastUsedAt          DateTime?
  lastSuccessAt       DateTime?
  lastFailedAt        DateTime?
  cooldownUntil       DateTime?                // Timestamp de término de suspensão por circuit breaker ou rate limit
  
  // Diagnóstico do último erro
  lastErrorCode       String?
  lastErrorMessage    String?
  
  // Configurações e restrições
  allowedModels       String[]                 @default([]) // Vazio = todos os modelos permitidos
  notes               String?
  
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  
  createdById         String?
  createdBy           User?                    @relation("CreatedGeminiKeys", fields: [createdById], references: [id], onDelete: SetNull)
  operationAttempts   GeminiOperationAttempt[]

  @@index([isActive, priority, status])
  @@index([cooldownUntil])
}

model GeminiSettings {
  id                      String                  @id @default(cuid())
  selectionStrategy       GeminiSelectionStrategy @default(SEQUENTIAL_PRIORITY)
  maxConsecutiveFailures  Int                     @default(3) // Falhas consecutivas para suspensão temporária
  cooldownSeconds         Int                     @default(300) // 5 minutos de espera para recuperação
  requestTimeoutMs        Int                     @default(45000) // 45 segundos de timeout padrão por requisição
  maxAttemptsPerOperation Int                     @default(3) // Quantidade máxima de chaves alternativas por operação
  envKeyFallbackAllowed   Boolean                 @default(true) // Permite fallback na process.env.GEMINI_API_KEY
  updatedAt               DateTime                @updatedAt
  updatedByUserId         String?
}

model GeminiOperationLog {
  id              String                   @id @default(cuid())
  operationId     String                   @unique // Identificador de rastreamento e idempotência da operação
  feature         String                   // ex: "CHARACTER_GENERATION", "CINEMATIC_ANALYSIS", "PROMPT_ENGINE", etc.
  model           String                   // ex: "gemini-3.5-flash", "gemini-2.5-pro"
  workspaceId     String?
  projectId       String?
  userId          String?
  
  success         Boolean                  @default(false)
  usedFallback    Boolean                  @default(false)
  attemptsCount   Int                      @default(1)
  
  primaryKeyName  String?                  // Nome da 1ª chave selecionada
  finalKeyName    String?                  // Nome da chave que concluiu a operação com sucesso
  
  durationMs      Int                      @default(0)
  inputTokens     Int?
  outputTokens    Int?
  
  statusCode      Int?
  errorCode       String?
  errorMessage    String?
  
  createdAt       DateTime                 @default(now())
  attempts        GeminiOperationAttempt[]

  @@index([feature, createdAt(sort: Desc)])
  @@index([success, usedFallback, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model GeminiOperationAttempt {
  id             String             @id @default(cuid())
  logId          String
  log            GeminiOperationLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  
  apiKeyId       String?
  apiKey         GeminiApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  keyName        String
  
  attemptNumber  Int
  success        Boolean
  durationMs     Int
  
  statusCode     Int?
  errorCode      String?
  errorMessage   String?
  isRecoverable  Boolean            @default(false)
  
  createdAt      DateTime           @default(now())

  @@index([logId, attemptNumber])
}

// ----------------------------------------------------
// ARQUITETURA DE PROVEDORES DE GERAÇÃO DE IMAGENS IA
// ----------------------------------------------------

enum ImageProviderStatus {
  CONNECTED
  UNCONFIGURED
  INVALID_KEY
  INSUFFICIENT_BALANCE
  ERROR
  UNREACHABLE
}

model ImageProviderConfig {
  id               String              @id @default(cuid())
  providerId       String              @unique // ex: "pollinations"
  name             String              // ex: "Pollinations.ai"
  apiKey           String              // Persistida exclusivamente com segurança no backend
  maskedKey        String              // Versão mascarada para exibição no console admin (ex: sk_live...8831)
  baseUrl          String              @default("https://gen.pollinations.ai")
  isActive         Boolean             @default(true)
  defaultModel     String?             // ex: "flux"
  connectionStatus ImageProviderStatus @default(UNCONFIGURED)
  lastTestedAt     DateTime?
  lastTestMessage  String?
  lastUsedAt       DateTime?
  
  requestsCount    Int                 @default(0)
  successCount     Int                 @default(0)
  failuresCount    Int                 @default(0)
  
  customConfig     Json?               @default("{}")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  models           ImageModelConfig[]
  operationLogs    ImageOperationLog[]

  @@index([providerId, isActive])
}

model ImageModelConfig {
  id                     String              @id @default(cuid())
  providerConfigId       String
  modelId                String              // ex: "flux", "turbo", "flux-realism"
  name                   String
  publisher              String?
  description            String?
  capabilities           Json                @default("[\"TEXT_TO_IMAGE\"]")
  supportedSizes         Json                @default("[\"1024x1024\", \"1280x720\", \"720x1280\"]")
  supportsReferenceImage Boolean             @default(false)
  supportsImageEditing   Boolean             @default(false)
  pricingInfo            Json?               @default("{}")
  
  isAvailable            Boolean             @default(true) // Retornado no catálogo da API
  isEnabled              Boolean             @default(true) // Habilitado pelo admin
  isDefault              Boolean             @default(false)
  defaultCreditCost      Int?                // Custo customizado em créditos do Tomadix
  displayOrder           Int                 @default(0)
  lastSyncedAt           DateTime            @default(now())
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  providerConfig         ImageProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([providerConfigId, modelId])
  @@index([providerConfigId, isEnabled, isAvailable])
}

model GeneratedImage {
  id               String          @id @default(cuid())
  userId           String
  workspaceId      String
  projectId        String?
  characterId      String?
  environmentId    String?
  sceneId          String?
  promptVersionId  String?
  
  providerId       String          // ex: "pollinations"
  modelId          String          // ex: "flux"
  prompt           String          // Prompt textual enviado para geração
  revisedPrompt    String?         // Prompt revisado/retornado pela IA caso disponível
  negativePrompt   String?
  parameters       Json            @default("{}")
  aspectRatio      String?         // "1:1", "16:9", "9:16", "21:9", etc.
  resolution       String?         // "1024x1024", "1280x720", etc.
  
  imageUrl         String          // URL acessível ou caminho servível para a imagem gerada
  storageKey       String?         // Chave interna / caminho relativo de persistência
  creditCost       Int             @default(0)
  externalCost     Float?          // Custo externo do provedor (se disponibilizado)
  externalCostUnit String?         // ex: "pollen", "USD"
  
  status           String          @default("SUCCEEDED") // "PENDING", "PROCESSING", "SUCCEEDED", "FAILED"
  errorMessage     String?
  generationTimeMs Int             @default(0)
  metadata         Json?           @default("{}")
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  character        Character?      @relation(fields: [characterId], references: [id], onDelete: SetNull)
  environment      Environment?    @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  scene            Scene?          @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  promptVersion    PromptVersion?  @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

model ImageOperationLog {
  id               String               @id @default(cuid())
  operationId      String               @unique // UUID para idempotência e auditoria
  providerId       String
  modelId          String
  workspaceId      String?
  userId           String?
  projectId        String?
  
  success          Boolean              @default(false)
  statusCode       Int?
  errorCode        String?
  errorMessage     String?
  durationMs       Int                  @default(0)
  externalCost     Float?
  externalCostUnit String?
  creditCost       Int                  @default(0)
  requestPayload   Json?                // Sanitizado sem chaves
  
  createdAt        DateTime             @default(now())

  providerConfig   ImageProviderConfig? @relation(fields: [providerId], references: [providerId], onDelete: SetNull)

  @@index([providerId, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

// ============================================================================
// SISTEMA DE E-MAIL (GMAIL, GOOGLE WORKSPACE, OUTLOOK, HOTMAIL, OFFICE 365, SMTP)
// ============================================================================

enum EmailProviderType {
  GMAIL_SMTP
  OUTLOOK_SMTP
  CUSTOM_SMTP
  OFFICE365_OAUTH2
  GMAIL_OAUTH2
}

model EmailSettings {
  id                 String            @id @default("default")
  provider           EmailProviderType @default(GMAIL_SMTP)
  isEnabled          Boolean           @default(false)
  
  // SMTP settings
  smtpHost           String            @default("smtp.gmail.com")
  smtpPort           Int               @default(587)
  smtpSecure         Boolean           @default(false)
  smtpUser           String?
  smtpPasswordEnc    String?
  
  // OAuth2 settings
  clientId           String?
  clientSecretEnc    String?
  refreshTokenEnc    String?
  tenantId           String?
  
  // Remetente
  senderEmail        String            @default("noreply@tomadix.com")
  senderName         String            @default("Tomadix")
  replyTo            String?
  
  // Teste e Status
  lastTestedAt       DateTime?
  lastTestStatus     String?           // "SUCCESS", "FAILED"
  lastTestError      String?
  
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model EmailLog {
  id           String    @id @default(cuid())
  recipient    String
  subject      String
  provider     String
  status       String    // "SENT", "FAILED"
  messageId    String?
  errorMessage String?
  metadata     Json?     @default("{}")
  createdAt    DateTime  @default(now())

  @@index([status, createdAt(sort: Desc)])
  @@index([recipient, createdAt(sort: Desc)])
}

