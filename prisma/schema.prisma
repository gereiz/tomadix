generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ParameterType {
  TEXT
  TEXTAREA
  SELECT
  MULTISELECT
  BOOLEAN
  NUMBER
  RANGE
  DURATION
  JSON
  DATE
}

enum ParameterScope {
  GLOBAL
  CHARACTER
  ENVIRONMENT
  SCENE
  OUTPUT
}

enum GenerationStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELING
  CANCELED
  UNPAID
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
  EXPIRED
}

enum PlatformRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id                          String             @id @default(cuid())
  authSubject                 String             @unique
  email                       String             @unique
  displayName                 String?
  passwordHash                String?
  platformRole                PlatformRole       @default(USER)
  isSuspended                 Boolean            @default(false)
  suspendedAt                 DateTime?
  suspensionReason            String?
  emailConfirmed              Boolean            @default(false)
  emailConfirmationToken      String?            @unique
  emailConfirmationExpiresAt  DateTime?
  passwordResetToken          String?            @unique
  passwordResetExpiresAt      DateTime?
  preferences                 Json?              @default("{}")
  onboardingCompleted         Boolean            @default(false)
  onboardingStep              Int                @default(1)
  memberships                 Membership[]
  sessions                    Session[]
  auditLogs                   AuditLog[]
  sentInvites                 WorkspaceInvite[]    @relation("SentInvites")
  platformAuditLogs           PlatformAuditLog[]   @relation("AdminAuditLogs")
  consents                    ConsentRecord[]
  dataSubjectRequests         DataSubjectRequest[]
  entitlementOverrides        UserEntitlementOverride[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@index([platformRole])
  @@index([isSuspended])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String   // "TERMS_OF_SERVICE", "PRIVACY_POLICY", "MARKETING_EMAILS", "AI_DATA_PROCESSING"
  version     String   // "1.0", "2026-10"
  granted     Boolean  @default(true)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
  @@index([consentType, createdAt])
}

model DataSubjectRequest {
  id          String    @id @default(cuid())
  userId      String?
  email       String
  requestType String    // "ACCESS", "RECTIFICATION", "DELETION", "REVOCATION", "PORTABILITY"
  status      String    @default("PENDING") // "PENDING", "IN_REVIEW", "COMPLETED", "REJECTED"
  details     String?
  resolution  String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, status])
  @@index([requestType, status])
}

model PlatformAuditLog {
  id          String       @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  result      String       @default("SUCCESS")
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())
  adminUser   User         @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  workspaceId String?
  action      String
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  isPersonal     Boolean           @default(false)
  isArchived     Boolean           @default(false)
  archivedAt     DateTime?
  settings       Json?             @default("{}")
  creditsBalance Int               @default(20)
  memberships    Membership[]
  invites        WorkspaceInvite[]
  projects                    Project[]
  subscription                Subscription?
  invoices                    Invoice[]
  creditLedgers               CreditLedger[]
  entitlementOverrides        UserEntitlementOverride[]
  transfersFrom               ProjectOwnershipTransfer[] @relation("TransfersFrom")
  transfersTo                 ProjectOwnershipTransfer[] @relation("TransfersTo")
  createdAt                   DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([isArchived])
}

model Plan {
  id                    String         @id @default(cuid())
  tier                  PlanTier       @unique
  code                  String?        @unique
  name                  String
  description           String
  badge                 String?
  displayOrder          Int            @default(0)
  isHighlighted         Boolean        @default(false)
  targetAudience        String?
  commercialStatus      String         @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  isPublic              Boolean        @default(true)
  priceMonthly          Int            @default(0)
  priceYearly           Int            @default(0)
  currency              String         @default("BRL")
  annualDiscountPercent Int            @default(0)
  trialDays             Int            @default(0)
  promoPriceMonthly     Int?
  promoPriceYearly      Int?
  promoStartsAt         DateTime?
  promoEndsAt           DateTime?
  isOfferAvailable      Boolean        @default(true)
  externalGatewayIds    Json?          @default("{}")
  maxProjects           Int            @default(2)
  unlimitedProjects     Boolean        @default(false)
  maxMembers            Int            @default(1)
  unlimitedMembers      Boolean        @default(false)
  maxCharacters         Int?
  unlimitedCharacters   Boolean        @default(true)
  maxEnvironments       Int?
  unlimitedEnvironments Boolean        @default(true)
  maxScenes             Int?
  unlimitedScenes       Boolean        @default(true)
  monthlyCredits        Int            @default(20)
  maxConcurrentJobs     Int            @default(1)
  rateLimitPerMin       Int            @default(30)
  maxInputChars         Int            @default(10000)
  generationTypes       Json           @default("[\"TEXT\", \"DETAILED\", \"CINEMATIC\"]")
  hasPremiumTemplates   Boolean        @default(false)
  hasAdvancedParameters Boolean        @default(false)
  historyRetentionDays  Int            @default(30)
  unlimitedHistory      Boolean        @default(false)
  exportFormats         Json           @default("[\"TXT\", \"JSON\"]")
  priorityProcessing    Boolean        @default(false)
  features              Json           @default("[]")
  enabledTemplates      Json           @default("[]")
  exportAllowed         Boolean        @default(true)
  visualBibleAdvanced   Boolean        @default(false)
  customRules           Json?          @default("{}")
  gatewayProductId      String?
  gatewayPriceIdMonthly String?
  gatewayPriceIdYearly  String?
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
  gatewayMappings       GatewayPlanPriceMapping[]
}

model Subscription {
  id                    String             @id @default(cuid())
  workspaceId           String             @unique
  planTier              PlanTier           @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)
  interval              BillingInterval    @default(MONTHLY)
  billingUserId         String?
  customerId            String?
  gatewaySubscriptionId String?            @unique
  currentPeriodStart    DateTime           @default(now())
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  trialStart            DateTime?
  trialEnd              DateTime?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  workspace             Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                  Plan               @relation(fields: [planTier], references: [tier])
  invoices              Invoice[]

  @@index([workspaceId, status])
  @@index([customerId])
  @@index([gatewaySubscriptionId])
}

model Invoice {
  id               String        @id @default(cuid())
  subscriptionId   String?
  workspaceId      String
  gatewayInvoiceId String?       @unique
  amountDue        Int
  amountPaid       Int
  currency         String        @default("BRL")
  status           String        @default("paid")
  hostedInvoiceUrl String?
  pdfUrl           String?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  workspace        Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model CreditLedger {
  id           String    @id @default(cuid())
  workspaceId  String
  amount       Int
  balanceAfter Int
  reason       String
  metadata     Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ProcessedWebhookEvent {
  id          String   @id
  gateway     String
  eventType   String
  processedAt DateTime @default(now())
  payload     Json?
  status      String   @default("PROCESSED")
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId, role])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  status      InviteStatus  @default(PENDING)
  invitedById String
  invitedBy   User          @relation("SentInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([workspaceId, status])
  @@index([email, status])
  @@index([token])
}

model Project {
  id              String        @id @default(cuid())
  workspaceId     String
  title           String
  description     String        @default("")
  genre           String?
  language        String        @default("pt-BR")
  durationSeconds Int?
  configuration   Json          @default("{}")
  visualBible     Json?
  isArchived      Boolean       @default(false)
  archivedAt      DateTime?
  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parameterValues ParameterValue[]
  characters      Character[]
  environments    Environment[]
  scenes          Scene[]
  generations     GenerationJob[]
  transfers       ProjectOwnershipTransfer[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId, updatedAt])
  @@index([workspaceId, isArchived])
}

model ParameterDefinition {
  id             String          @id @default(cuid())
  workspaceId    String?
  key            String
  label          String
  description    String?
  type           ParameterType
  scope          ParameterScope @default(GLOBAL)
  scopes         Json?
  required       Boolean         @default(false)
  defaultValue   Json?
  options        Json?
  validationRules Json?
  visibilityRules Json?
  promptMapping  Json?
  order          Int             @default(0)
  version        Int             @default(1)
  isSystem       Boolean         @default(false)
  enabled        Boolean         @default(true)
  values          ParameterValue[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([workspaceId, key, version])
  @@index([workspaceId, enabled, scope])
}

model ParameterValue {
  id                   String              @id @default(cuid())
  projectId             String
  parameterDefinitionId String
  targetType            String              @default("PROJECT")
  targetId              String?
  value                 Json
  project               Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition            ParameterDefinition @relation(fields: [parameterDefinitionId], references: [id], onDelete: Restrict)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([projectId, targetType, targetId])
  @@index([parameterDefinitionId])
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  attributes  Json     @default("{}")
  isArchived  Boolean  @default(false)
  archivedAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneLinks  SceneCharacter[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, name])
  @@index([projectId, isArchived])
}

model Environment {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  attributes  Json     @default("{}")
  isArchived  Boolean  @default(false)
  archivedAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneLinks  SceneEnvironment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, name])
  @@index([projectId, isArchived])
}

model Scene {
  id              String             @id @default(cuid())
  projectId       String
  title           String
  order           Int
  durationSeconds Int?
  description     String             @default("")
  configuration   Json               @default("{}")
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characters      SceneCharacter[]
  environments    SceneEnvironment[]
  promptVersions  PromptVersion[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([projectId, order])
  @@index([projectId, order])
}

model SceneCharacter {
  sceneId       String
  characterId   String
  configuration Json      @default("{}")
  scene         Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([sceneId, characterId])
}

model SceneEnvironment {
  sceneId       String
  environmentId String
  configuration Json        @default("{}")
  scene         Scene       @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@id([sceneId, environmentId])
}

model PromptTemplate {
  id             String   @id @default(cuid())
  key            String
  name           String
  version        Int
  outputSchema   String
  instructions   String
  sections       Json
  enabled        Boolean  @default(true)
  isSystem       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([key, version])
  @@index([key, enabled])
}

model PromptVersion {
  id                  String   @id @default(cuid())
  sceneId             String?
  projectId           String
  templateKey         String
  templateVersion     Int
  targetTool           String
  modelName            String
  inputSnapshot        Json
  outputJson           Json
  outputText           String?
  createdAt            DateTime @default(now())
  scene                Scene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([sceneId, createdAt])
}

model GenerationJob {
  id             String           @id @default(cuid())
  projectId      String
  status         GenerationStatus @default(PENDING)
  modelName      String
  request        Json
  result         Json?
  errorMessage   String?
  inputTokens    Int?
  outputTokens   Int?
  startedAt      DateTime?
  finishedAt     DateTime?
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([projectId, status, createdAt])
}

model CommercialPolicy {
  id           String   @id @default(cuid())
  key          String   @unique
  category     String   // "CREDITS" | "SUBSCRIPTIONS" | "USAGE_LIMITS" | "COMMERCIALIZATION" | "GENERAL"
  label        String
  description  String?
  dataType     String   @default("string") // "string" | "number" | "boolean" | "json"
  value        Json
  defaultValue Json
  validation   Json?
  isSystem     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@index([category])
}

model CommercialSnapshot {
  id             String   @id @default(cuid())
  subscriptionId String?
  workspaceId    String
  planTier       PlanTier
  snapshotData   Json
  acceptedAt     DateTime @default(now())
  acceptedBy     String?
  version        String   @default("v1")
  reason         String   @default("NEW_CONTRACT")

  @@index([workspaceId, planTier])
  @@index([subscriptionId])
}

model PaymentGatewayConfig {
  id                   String   @id @default(cuid())
  name                 String
  identifier           String   @unique
  provider             String   // "STRIPE" | "MERCADOPAGO" | "SANDBOX"
  environment          String   @default("SANDBOX") // "SANDBOX" | "PRODUCTION"
  status               String   @default("ACTIVE") // "ACTIVE" | "INACTIVE" | "CONFIG_PENDING" | "ERROR"
  connectionStatus     String   @default("UNTESTED") // "CONNECTED" | "DISCONNECTED" | "UNTESTED" | "FAILED"
  encryptedCredentials Json?
  supportedCurrencies  Json     @default("[\"BRL\", \"USD\"]")
  supportedCountries   Json     @default("[\"BR\"]")
  paymentMethods       Json     @default("[\"CREDIT_CARD\"]")
  lastTestedAt         DateTime?
  lastError            String?
  isCheckoutDefault    Boolean  @default(false)
  priorityOrder        Int      @default(0)
  selectionRules       Json?    @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  mappings             GatewayPlanPriceMapping[]
  webhookEvents        PaymentWebhookEvent[]

  @@index([provider, environment])
  @@index([status, environment])
}

model GatewayPlanPriceMapping {
  id                     String               @id @default(cuid())
  gatewayConfigId        String
  planTier               PlanTier
  environment            String               @default("SANDBOX") // "SANDBOX" | "PRODUCTION"
  externalProductId      String?
  externalPriceIdMonthly String?
  externalPriceIdYearly  String?
  currency               String               @default("BRL")
  syncStatus             String               @default("SYNCED") // "SYNCED" | "DESYNC" | "ERROR"
  lastSyncedAt           DateTime?
  gatewayConfig          PaymentGatewayConfig @relation(fields: [gatewayConfigId], references: [id], onDelete: Cascade)
  plan                   Plan                 @relation(fields: [planTier], references: [tier], onDelete: Cascade)

  @@unique([gatewayConfigId, planTier, environment])
  @@index([planTier, environment])
}

model PaymentWebhookEvent {
  id              String                @id @default(cuid())
  eventId         String                @unique
  gatewayConfigId String?
  gateway         String
  environment     String                @default("SANDBOX")
  eventType       String
  status          String                @default("PROCESSED") // "RECEIVED" | "PROCESSED" | "FAILED"
  attempts        Int                   @default(1)
  lastError       String?
  rawPayload      Json?
  processedAt     DateTime?
  createdAt       DateTime              @default(now())
  gatewayConfig   PaymentGatewayConfig? @relation(fields: [gatewayConfigId], references: [id], onDelete: SetNull)

  @@index([gateway, eventType])
  @@index([status, createdAt])
  @@index([environment])
}

model CreditOperation {
  id                 String              @id @default(cuid())
  code               String              @unique // "GEN_CHARACTER", "GEN_ENVIRONMENT", etc.
  name               String
  description        String?
  category           String              // "CHARACTERS", "ENVIRONMENTS", "PROMPTS", "SCENES", "EXPANSIONS", "BATCH", "PREMIUM"
  defaultCreditCost  Int                 @default(1)
  isFree             Boolean             @default(false)
  isActive           Boolean             @default(true)
  version            Int                 @default(1)
  pricingRules       CreditPricingRule[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([category, isActive])
}

model CreditPricingRule {
  id                 String          @id @default(cuid())
  operationId        String
  planTier           PlanTier?
  creditCost         Int
  isFree             Boolean         @default(false)
  effectiveFrom      DateTime        @default(now())
  effectiveUntil     DateTime?
  priority           Int             @default(1)
  isActive           Boolean         @default(true)
  version            Int             @default(1)
  operation          CreditOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([operationId, planTier, isActive])
}

model CreditRenewalPolicy {
  id                 String          @id @default(cuid())
  name               String
  description        String?
  planTier           PlanTier?
  creditsAmount      Int
  frequency          String          // "DAILY", "WEEKLY", "MONTHLY", "YEARLY", "ONCE", "CYCLE"
  moment             String          @default("CYCLE_RENEWAL") // "CYCLE_RENEWAL", "SIGNUP", "SCHEDULED"
  accumulate         Boolean         @default(false)
  maxAccumulated     Int?
  expirationDays     Int?
  priority           Int             @default(1)
  isActive           Boolean         @default(true)
  startsAt           DateTime        @default(now())
  endsAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([planTier, isActive])
}

model UserEntitlementOverride {
  id                 String          @id @default(cuid())
  userId             String
  workspaceId        String?
  grantedPlanTier    PlanTier?
  courtesyCredits    Int?
  expiresAt          DateTime?
  reason             String
  adminUserId        String
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([workspaceId, isActive])
}

model ProjectOwnershipTransfer {
  id                 String          @id @default(cuid())
  projectId          String
  fromWorkspaceId    String
  toWorkspaceId      String
  fromUserId         String?
  toUserId           String?
  reason             String
  adminUserId        String
  transferredAt      DateTime        @default(now())

  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromWorkspace      Workspace       @relation("TransfersFrom", fields: [fromWorkspaceId], references: [id], onDelete: Cascade)
  toWorkspace        Workspace       @relation("TransfersTo", fields: [toWorkspaceId], references: [id], onDelete: Cascade)

  @@index([projectId, transferredAt])
  @@index([fromWorkspaceId])
  @@index([toWorkspaceId])
}

